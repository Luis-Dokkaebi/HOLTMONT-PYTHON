{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_puertas.sh\"",
            "timeout": 10,
            "statusMessage": "Directiva Cero: verificando que no se toque una puerta"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar_pruebas.sh\"",
            "timeout": 600,
            "statusMessage": "R1: corriendo la suite antes de dar por terminado"
          }
        ]
      }
    ]
  }
}
