# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore.
# NUNCA pongas credenciales reales aquí ni como valor por defecto en el código.

# --- Supabase -------------------------------------------------------------
# URL del proyecto y clave de servicio (backend). La clave `anon` no sirve
# mientras no haya políticas RLS definidas (Fase 4 del plan).
SUPABASE_URL=
SUPABASE_KEY=

# Conexión Postgres directa, para SQLAlchemy con pool (Fase 1 del plan).
# Formato: postgresql+psycopg://USUARIO:CLAVE@HOST:5432/postgres
# Si el entorno no tiene TCP al 5432, se usa la ruta REST con SUPABASE_KEY.
DATABASE_URL=

# --- Capa relacional (backend/, Fase 1) -----------------------------------
# Motor de datos. Vacío = automático: SQLAlchemy si hay DATABASE_URL, PostgREST
# si hay SUPABASE_URL/KEY. Valores: sqlalchemy | postgrest | memoria.
# `memoria` es el doble de pruebas y no persiste nada; nunca en producción.
#
# Se comprobó que este entorno de desarrollo no tiene salida TCP fuera del 443,
# así que ahí solo funciona `postgrest`. En Vercel sí hay TCP y `sqlalchemy` es
# la opción correcta: es la única con transacciones reales.
BACKEND_ENGINE=

# Interruptor de la escritura. ENCENDIDO por defecto: Supabase es la base de la
# aplicación y cada usuario guarda en su partición (`source_sheet`) de `tasks`
# o de `quotes`.
#
# Ponlo en 0 SOLO como parada de emergencia. Mientras esté apagado, todo intento
# de guardar del tracker devuelve un error visible (nunca un falso "guardado").
BACKEND_TASKS_WRITE_ENABLED=

# --- Integraciones externas ----------------------------------------------
# Webhook de Make.com que crea los eventos en Outlook 365 al asignar tarea.
# Si está vacío, NotifierService no envía nada (no rompe el guardado).
MAKE_WEBHOOK_URL=

# API de Google Gemini para los reportes de KPI de cotizaciones.
GEMINI_API_KEY=

# --- Servidor -------------------------------------------------------------
PORT=8000

# Orígenes permitidos por CORS, separados por coma. Si se deja vacío la API
# responde con `*` pero SIN permitir credenciales.
# Ej.: CORS_ORIGINS=https://holtmont.example.com,http://localhost:8000
CORS_ORIGINS=

# --- Login de desarrollo (temporal) --------------------------------------
# Sustituye al MOCK_USER_DB que estaba hardcodeado en api/main.py.
# Solo se consulta cuando no hay base de datos configurada.
# Formato: USUARIO:contrasena:ROL:Etiqueta, separados por coma.
# Roles válidos: ADMIN, ADMIN_CONTROL, PPC_ADMIN, TONITA, WORKORDER_USER,
#                ANGEL_USER, TERESA_USER, EDUARDO_USER, MANZANARES_USER,
#                RAMIRO_USER, SEBASTIAN_USER, EDGAR_USER
# Desaparece cuando la Fase 4 del plan active Supabase Auth con JWT.
DEV_LOGIN_USERS=
